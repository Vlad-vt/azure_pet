# Copy to .env for local development. Never commit the real .env.
# Application
SKUMATCH_ENV=local
SKUMATCH_LOG_LEVEL=INFO

# Database (local docker-compose goes through PgBouncer on :6432)
SKUMATCH_DATABASE_URL=postgresql+asyncpg://skumatch:skumatch@localhost:6432/skumatch
# Direct connection used by Alembic migrations (PgBouncer transaction mode is not migration-safe)
SKUMATCH_DATABASE_URL_DIRECT=postgresql+asyncpg://skumatch:skumatch@localhost:5432/skumatch
SKUMATCH_DB_POOL_SIZE=5
SKUMATCH_DB_MAX_OVERFLOW=5
# Set to true when connecting through PgBouncer in transaction mode (disables prepared statement cache)
SKUMATCH_DB_PGBOUNCER=true

# Embeddings
SKUMATCH_MODEL_DIR=./models/multilingual-e5-small

# Retrieval
SKUMATCH_RRF_K=60
SKUMATCH_RRF_W_DENSE=1.0
SKUMATCH_RRF_W_FTS=1.0
SKUMATCH_RRF_W_TRGM=1.0
SKUMATCH_CANDIDATES_PER_RETRIEVER=50

# Optional LLM-as-a-judge (eval only, disabled when unset)
# OPENAI_API_KEY=
# GEMINI_API_KEY=
